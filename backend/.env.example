# Banco (o docker-compose.yml sobe um Postgres com estes dados)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financeiro

# Chave para assinar os tokens JWT. Em produção, use um valor longo e aleatório.
JWT_SECRET=troque-por-um-valor-secreto
# Validade do token (formato do jsonwebtoken: 1d, 12h, 30m...)
JWT_EXPIRES_IN=1d

# Porta da API (a 3000 fica para o frontend)
PORT=3333
# Origem liberada no CORS
FRONTEND_URL=http://localhost:3000
