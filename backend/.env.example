# Banco PostgreSQL (credenciais do docker-compose.yml, só para desenvolvimento)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financeiro"

# Segredo para assinar os tokens JWT. Gere um com: openssl rand -hex 32
JWT_SECRET=""
# Validade do token (ex.: 1d, 12h)
JWT_EXPIRES_IN="1d"

# Porta da API (padrão: 3333) e origem liberada no CORS (padrão: http://localhost:3000)
# PORT=3333
# FRONTEND_URL=http://localhost:3000
