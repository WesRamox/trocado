// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  // Fuso IANA da pessoa (ex.: America/Sao_Paulo): define o "hoje" das recorrências
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cards           Card[]
  transactions    Transaction[]
  recurrences     Recurrence[]
  categories      Category[]
  invoicePayments InvoicePayment[]
  people          Person[]
  loans           Loan[]

  @@map("users")
}

model Card {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  type               CardType
  name               String
  lastFourDigits     String    @map("last_four_digits") @db.Char(4)
  brand              CardBrand @default(OTHER)
  // Cor do cartão (hex); sem cor, o app escolhe uma pelo id
  color              String?   @db.VarChar(7)
  // Somente para cartão de crédito
  closingDay         Int?      @map("closing_day")
  dueDay             Int?      @map("due_day")
  creditLimitInCents Int?      @map("credit_limit_in_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurrences     Recurrence[]
  invoicePayments InvoicePayment[]

  @@index([userId])
  @@map("cards")
}

model Transaction {
  id               Int             @id @default(autoincrement())
  userId           Int             @map("user_id")
  cardId           Int?            @map("card_id")
  categoryId       Int?            @map("category_id")
  recurrenceId     Int?            @map("recurrence_id")
  // Compra feita por outra pessoa no seu cartão: não é gasto seu, ela te reembolsa
  personId         Int?            @map("person_id")
  // Dia em que a pessoa reembolsou esta compra (ou parcela)
  reimbursedAt     DateTime?       @map("reimbursed_at") @db.Date
  // Parcela de um empréstimo bancário
  loanId           Int?            @map("loan_id")
  // Parte de uma compra dividida: aponta para a parcela original, de onde o valor saiu
  splitOfId        Int?            @map("split_of_id")
  name             String
  description      String?
  amountInCents    Int             @map("amount_in_cents")
  type             TransactionType
  date             DateTime        @db.Date
  // Vencimento da fatura em que o lançamento entra (só cartão de crédito)
  invoiceDueDate   DateTime?       @map("invoice_due_date") @db.Date
  // Parte da fatura informada só pelo total, sem os itens (no máximo um por fatura)
  invoiceRemainder Boolean         @default(false) @map("invoice_remainder")

  // Parcelamento: todas as parcelas de uma compra compartilham o mesmo installmentGroupId
  installmentNumber  Int?    @map("installment_number")
  installmentCount   Int?    @map("installment_count")
  installmentGroupId String? @map("installment_group_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurrence Recurrence?   @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  person     Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  loan       Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  splitOf    Transaction?  @relation("SplitParts", fields: [splitOfId], references: [id], onDelete: Cascade)
  splitParts Transaction[] @relation("SplitParts")

  @@index([userId, date])
  @@index([personId])
  @@index([splitOfId])
  @@index([loanId])
  @@index([cardId, invoiceDueDate])
  @@index([categoryId])
  @@index([recurrenceId])
  @@index([installmentGroupId])
  @@map("transactions")
}

// Pagamento (total ou parcial) de uma fatura. Não é um gasto: as compras da fatura já são
// lançamentos. Serve para saber o que falta pagar e liberar o limite do cartão.
model InvoicePayment {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  cardId         Int      @map("card_id")
  // Vencimento da fatura paga
  invoiceDueDate DateTime @map("invoice_due_date") @db.Date
  amountInCents  Int      @map("amount_in_cents")
  // Dia do pagamento
  date           DateTime @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, invoiceDueDate])
  @@index([userId])
  @@map("invoice_payments")
}

// Quem usa seus cartões (pai, mãe, namorada...) e te reembolsa
model Person {
  id     Int     @id @default(autoincrement())
  userId Int     @map("user_id")
  name   String  @db.VarChar(50)
  color  String? @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("people")
}

// Empréstimo bancário: as parcelas viram lançamentos (uma por mês, a partir da 1ª)
model Loan {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  categoryId      Int?     @map("category_id")
  name            String   @db.VarChar(100)
  // Quanto você vai pagar no total (parcelas somadas, com juros)
  totalInCents    Int      @map("total_in_cents")
  installments    Int
  firstDueDate    DateTime @map("first_due_date") @db.Date
  // Quanto caiu na sua conta; opcional, serve para calcular os juros
  receivedInCents Int?     @map("received_in_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@map("loans")
}

model Recurrence {
  id                Int                 @id @default(autoincrement())
  userId            Int                 @map("user_id")
  cardId            Int?                @map("card_id")
  categoryId        Int?                @map("category_id")
  name              String
  description       String?
  amountInCents     Int                 @map("amount_in_cents")
  type              TransactionType
  // Repete a cada `interval` unidades de `frequency` (ex.: MONTHLY + 3 = trimestral)
  frequency         RecurrenceFrequency
  interval          Int                 @default(1)
  // O dia das ocorrências segue o startDate (ex.: começa dia 10 -> todo dia 10)
  startDate         DateTime            @map("start_date") @db.Date
  endDate           DateTime?           @map("end_date") @db.Date
  // Data da última ocorrência já gerada como Transaction
  lastGeneratedDate DateTime?           @map("last_generated_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([cardId])
  @@index([categoryId])
  @@map("recurrences")
}

model Category {
  id                   Int             @id @default(autoincrement())
  userId               Int             @map("user_id")
  name                 String
  type                 TransactionType
  color                String?         @db.VarChar(7) // hex, ex.: #FF8800
  icon                 String?
  // Limite de gastos por mês (só categorias de saída); null = sem orçamento
  monthlyBudgetInCents Int?            @map("monthly_budget_in_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]
  loans        Loan[]

  @@unique([userId, name, type])
  @@map("categories")
}

enum CardType {
  CREDIT
  DEBIT
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
